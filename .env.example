# Copie este arquivo para ".env.local" e preencha conforme necessário.
# Sem nenhuma variável, o sistema funciona em "modo protótipo":
#   - dados de exemplo em memória
#   - IA em modo simulado

# --- IA (Claude / Anthropic) ---
# Obtenha em https://console.anthropic.com
ANTHROPIC_API_KEY=

# --- Banco de dados (Supabase) ---
# No painel do Supabase: Project Settings -> API
# URL do projeto (ex.: https://xxxxxxxx.supabase.co)
SUPABASE_URL=
# service_role key (SECRETA — só no servidor; nunca exponha no navegador)
SUPABASE_SERVICE_ROLE_KEY=
